# Copy to /etc/ascii/image-build-sources.env on the image-build node.
# URL must name an immutable dated Ubuntu cloud-image release, never /current/.
UBUNTU_CLOUD_IMAGE_URL=https://cloud-images.ubuntu.com/noble/20260801/noble-server-cloudimg-amd64.img
UBUNTU_CLOUD_IMAGE_SHA256=0533b0655c32e68b31d792ecd6ccfca95abdbc536c4446874fe0513bd4140ffe
# Exact npm package version baked into /usr/local/bin/codex.
CODEX_VERSION=0.147.0
