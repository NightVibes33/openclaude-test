BAREMETAL_NODE_ID=node0
BAREMETAL_NODE_AGENT_BIND=127.0.0.1
BAREMETAL_NODE_AGENT_PORT=8787
# Per-node HMAC secret; the backend stores its AES-256-GCM ciphertext on this
# node's BareMetalNode row. There is no fleet-wide fallback. Rotations via
# POST /secret rewrite these two lines: the previous secret stays valid until
# the next rotation so a lost rotation response can never brick the node.
BAREMETAL_NODE_AGENT_HMAC_SECRET=replace-with-random-64-byte-secret
#BAREMETAL_NODE_AGENT_HMAC_SECRET_PREVIOUS=
# Required backend/operator CIDRs; startup fails when this list is empty.
BAREMETAL_NODE_AGENT_ALLOWED_IPS=replace-with-backend-ip-or-cidr
# Env file the agent rewrites when rotating secrets (defaults to this file).
BAREMETAL_NODE_AGENT_ENV_FILE=/etc/ascii/baremetal-node-agent.env
# Required self-signed cert served by the agent; the backend pins the exact cert.
# Startup fails rather than serving plain HTTP when either file is absent.
BAREMETAL_NODE_AGENT_TLS_CERT=/etc/ascii/node-agent-tls/cert.pem
BAREMETAL_NODE_AGENT_TLS_KEY=/etc/ascii/node-agent-tls/key.pem
# The active node-manager release (ASC-286): scripts and binary always come
# from the same verified release under this atomically-flipped symlink.
BAREMETAL_NODE_AGENT_REPO=/opt/ascii/node-manager/current
BAREMETAL_NODE_AGENT_MAX_CLOCK_SKEW_SECONDS=300
BAREMETAL_NODE_AGENT_MAX_BODY_BYTES=65536
# Max seconds to pull the golden qcow2 from R2 when the backend's create request
# carries a baseImageId the node does not have yet (needs /etc/ascii/r2-qemu-images.env).
BAREMETAL_IMAGE_FETCH_TIMEOUT_SECONDS=1800
BAREMETAL_PROVISION_CONCURRENCY=2
BAREMETAL_MEMORY_RESERVE_MB=16384
BAREMETAL_DISK_RESERVE_GB=100
BAREMETAL_VM_DISK_BUDGET_GB=70
BAREMETAL_MAX_VCPU_OVERCOMMIT=2
# Required for backend scheduling; missing/degraded host coverage removes the
# node from admission rather than silently running without abuse controls.
BAREMETAL_ABUSE_MONITOR=1
BAREMETAL_ABUSE_MONITOR_INTERVAL_SECONDS=10
BAREMETAL_ABUSE_BPF_PIN_ROOT=/sys/fs/bpf/ascii-node-agent

# Node-manager release stream (ASC-286): the update timer follows the channel;
# NODE_MANAGER_TAG_PIN wins while set (rollback = pin the last good tag).
NODE_MANAGER_CHANNEL=ascii-prod
#NODE_MANAGER_TAG_PIN=

# Passed through to provision-vm.sh. Both tags are immutable releases.
BACKEND_URL=https://ascii.dev
AGENTS_SERVER_CHANNEL=ascii-prod
AGENT_SERVER_TAG=agent-server-v0.0.49-ascii-prod29
BOX_CLI_TAG=box-cli-v0.1.0
BOX_CLI_CHANNEL=prod
BOX_CLI_MODE=box
CLEANUP_ON_FAILURE=1

# Per-guest vda limits. Zero means unlimited; set measured non-zero limits only
# when host telemetry demonstrates a noisy-neighbour problem.
VM_TOTAL_BYTES_SEC=0
VM_TOTAL_IOPS_SEC=0
